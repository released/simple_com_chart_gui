#include "resource.h"

#include <windows.h>
#include "build_version.h"

1 VERSIONINFO
 FILEVERSION CHART_VERSION_COMMA
 PRODUCTVERSION CHART_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Simple COM Chart\0"
            VALUE "FileVersion", CHART_VERSION_STR "\0"
            VALUE "ProductName", "Simple COM Chart\0"
            VALUE "ProductVersion", CHART_VERSION_STR "\0"
            VALUE "OriginalFilename", "SimpleComChart.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_MAIN_DIALOG DIALOGEX 0, 0, 520, 320
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_SYSMENU | WS_THICKFRAME
CAPTION "Plot Monitor"
FONT 9, "Segoe UI"
BEGIN
END

IDI_APPICON ICON "app.ico"

IDR_MAINMENU MENU
BEGIN
    POPUP "Help"
    BEGIN
        MENUITEM "Log Format", ID_HELP_LOGFORMAT
    END
END
