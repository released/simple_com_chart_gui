#include "resource.h"

#include <windows.h>
#include "build_version.h"

1 VERSIONINFO
 FILEVERSION CHART_VERSION_COMMA
 PRODUCTVERSION CHART_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Simple COM Chart\0"
            VALUE "FileVersion", CHART_VERSION_STR "\0"
            VALUE "ProductName", "Simple COM Chart\0"
            VALUE "ProductVersion", CHART_VERSION_STR "\0"
            VALUE "OriginalFilename", "SimpleComChart.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_MAIN_DIALOG DIALOGEX 0, 0, 520, 320
STYLE DS_SETFONT | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_SYSMENU | WS_THICKFRAME
CAPTION "Plot Monitor"
FONT 9, "Segoe UI"
BEGIN
END

IDI_APPICON ICON "app.ico"

IDD_Y_RANGE DIALOGEX 0, 0, 220, 90
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Fixed Y range (display units)"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Minimum", -1, 8, 12, 50, 14
    EDITTEXT IDC_Y_LOW, 65, 10, 145, 16, ES_AUTOHSCROLL
    LTEXT "Maximum", -1, 8, 36, 50, 14
    EDITTEXT IDC_Y_HIGH, 65, 34, 145, 16, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 100, 65, 50, 18
    PUSHBUTTON "Cancel", IDCANCEL, 160, 65, 50, 18
END

IDR_MAINMENU MENU
BEGIN
    POPUP "Settings"
    BEGIN
        POPUP "Startup tab"
        BEGIN
            MENUITEM "Messages", ID_STARTUP_MESSAGES
            MENUITEM "Chart", ID_STARTUP_CHART
            MENUITEM "4 Charts", ID_STARTUP_FOUR_CHARTS
        END
    END
    POPUP "Help"
    BEGIN
        MENUITEM "Log Format", ID_HELP_LOGFORMAT
    END
    POPUP "UART"
    BEGIN
        MENUITEM "Console / Serial options...", ID_UART_CONSOLE
        MENUITEM "Workbench / Dual COM...", ID_UART_WORKBENCH
        MENUITEM SEPARATOR
        MENUITEM "Start recording RX...", ID_UART_RECORD_START
        MENUITEM "Stop recording", ID_UART_RECORD_STOP
        MENUITEM "Recording options...", ID_UART_RECORD_OPTIONS
        MENUITEM SEPARATOR
        MENUITEM "Offline replay...", ID_UART_REPLAY
        MENUITEM "Binary replay schema...", ID_UART_BINARY_REPLAY
        MENUITEM "Derived channels...", ID_UART_DERIVED
        MENUITEM "Profiles...", ID_UART_PROFILES
        MENUITEM "Chart analysis...", ID_UART_ANALYSIS
        MENUITEM "Automation...", ID_UART_AUTOMATION
        MENUITEM "Stop automation", ID_UART_STOP_AUTOMATION
        MENUITEM SEPARATOR
        MENUITEM "Field extraction...", ID_UART_EXTRACTION
        MENUITEM "Channel display...", ID_UART_CHANNELS
        MENUITEM "Send file...", ID_UART_FILE_TX
    END
END

IDD_UART_CONSOLE DIALOGEX 0, 0, 650, 380
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_CONTROLPARENT
CAPTION "UART Console / Serial options"
FONT 9, "Segoe UI"
BEGIN
END

IDD_RECORD_OPTIONS DIALOGEX 0, 0, 250, 105
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Recording options"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Rotate raw file at (MiB, 1 - 1024):", -1, 10, 12, 170, 14
    EDITTEXT IDC_RECORD_MIB, 185, 10, 50, 16, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL "Also rotate when PC local date changes", IDC_RECORD_DAILY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 10, 36, 230, 18
    DEFPUSHBUTTON "OK", IDOK, 125, 76, 50, 18
    PUSHBUTTON "Cancel", IDCANCEL, 185, 76, 50, 18
END

IDD_ADVANCED_TOOLS DIALOGEX 0, 0, 700, 600
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
EXSTYLE WS_EX_TOOLWINDOW | WS_EX_CONTROLPARENT
CAPTION "Advanced UART tools"
FONT 9, "Segoe UI"
BEGIN
END

IDD_UART_WORKBENCH DIALOGEX 0, 0, 760, 600
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "UART Workbench - Dual COM"
FONT 9, "Segoe UI"
BEGIN
END

IDD_UART_TOOL_FORM DIALOGEX 0, 0, 540, 540
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "UART options"
FONT 9, "Segoe UI"
BEGIN
END

IDR_WORKBENCH_MENU MENU
BEGIN
    POPUP "Tools"
    BEGIN
        MENUITEM "Packet inspection A...", ID_WORKBENCH_FRAMING_A
        MENUITEM "Packet inspection B...", ID_WORKBENCH_FRAMING_B
        MENUITEM "Binary parser A...", ID_WORKBENCH_BINARY_A
        MENUITEM "Binary parser B...", ID_WORKBENCH_BINARY_B
        MENUITEM "Text charts B...", ID_WORKBENCH_TEXT_B
        MENUITEM "Field inspector A...", ID_WORKBENCH_INSPECT_A
        MENUITEM "Field inspector B...", ID_WORKBENCH_INSPECT_B
        MENUITEM SEPARATOR
        MENUITEM "Commands / Step scripts...", ID_WORKBENCH_COMMANDS
        MENUITEM "TX pacing A...", ID_WORKBENCH_PACING_A
        MENUITEM "TX pacing B...", ID_WORKBENCH_PACING_B
        MENUITEM SEPARATOR
        MENUITEM "File transfer A...", ID_WORKBENCH_TRANSFER_A
        MENUITEM "File transfer B...", ID_WORKBENCH_TRANSFER_B
        MENUITEM "Modbus RTU A...", ID_WORKBENCH_RTU_A
        MENUITEM "Modbus RTU B...", ID_WORKBENCH_RTU_B
        MENUITEM "Terminal screen A...", ID_WORKBENCH_TERMINAL_A
        MENUITEM "Terminal screen B...", ID_WORKBENCH_TERMINAL_B
        MENUITEM "Instruments / FFT...", ID_WORKBENCH_INSTRUMENTS
        MENUITEM "XY / Recorded-run comparison...", ID_WORKBENCH_SIGNALS
        MENUITEM "Start A/B forwarding...", ID_WORKBENCH_FORWARD
        MENUITEM "Stop operation A", ID_WORKBENCH_STOP_A
        MENUITEM "Stop operation B", ID_WORKBENCH_STOP_B
    END
END

IDD_UART_COMMANDS DIALOGEX 0, 0, 650, 480
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "UART Commands / Step scripts"
FONT 9, "Segoe UI"
BEGIN
END

IDD_UART_INSTRUMENTS DIALOGEX 0, 0, 720, 560
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "UART Instruments / FFT"
FONT 9, "Segoe UI"
